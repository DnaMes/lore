# sdist contents for downstream packagers.
# Wheel package-data still comes from [tool.setuptools.package-data].

include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include pyproject.toml
include lore_cli.py
include lore_session_cli.py

graft lore
graft tests
graft docs
graft tools

# Maintainer working notes live in the tree while a backlog sweep runs; never ship them.
prune docs/triage
