# Variables below are read by Annuli (or by docker-compose.yml for bind/data).
# Copy to .env and adjust. Do not commit .env.

# --- Docker Compose (docker-compose.yml; not read by the Python app) ---
# ANNULI_BIND=127.0.0.1
# Optional host bind for data (default is the named volume annuli-data).
# Host path must be writable by container uid 10001 (or ANNULI_UID with sources overlay).
# ANNULI_DATA_DIR=./annuli-data
# ANNULI_UID=
# ANNULI_GID=

# --- Web / CORS (read by annuli) ---
# Comma-separated origins allowed in addition to same-origin, e.g. https://annuli.example.com
# (reverse-proxy origin policy; honored only while TRUSTED_PROXY=1)
ANNULI_PUBLIC_ORIGINS=
# Comma-separated extra Host-header values the web UI accepts (e.g. annuli.example.com).
# The literal '*' disables Host validation entirely.
# ANNULI_ALLOWED_HOSTS=

# --- Rate limits (web UI) ---
ANNULI_RATE_LIMIT_ENABLED=true
ANNULI_RATE_LIMIT_WINDOW_SECONDS=60
ANNULI_RATE_LIMIT_MAX_API_REQUESTS=240
ANNULI_RATE_LIMIT_SEARCH_PER_WINDOW=180
ANNULI_RATE_LIMIT_AUDIT_PER_WINDOW=20
ANNULI_RATE_LIMIT_RELOAD_PER_WINDOW=12
ANNULI_JSON_REQUEST_LOGS=false

# --- Optional (read by annuli; uncomment when needed) ---
# FLASK_SECRET_KEY=
# TRUSTED_PROXY=1
# ANNULI_WEB_HOST=127.0.0.1
# ANNULI_WEB_PORT=5000
# ANNULI_WATCH=1
# ANNULI_WATCH_INTERVAL=30
# ANNULI_HYBRID_SEARCH=1
# ANNULI_USE_V2=1
# ANNULI_LLM_PROVIDER=
# ANNULI_OPENROUTER_MODEL=
# ANNULI_OPENROUTER_ALLOW_PAID=0
# ANNULI_MCP_ALLOW_SUMMARIZE=0
# ANNULI_SUMMARY_PROVIDER=
# ANNULI_SUMMARY_MODEL=
