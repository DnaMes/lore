# Variables below are read by Lore (or by docker-compose.yml for bind/data).
# Copy to .env and adjust. Do not commit .env.

# --- Docker Compose (docker-compose.yml; not read by the Python app) ---
# LORE_BIND=127.0.0.1
# LORE_DATA_DIR=./lore-data

# --- Web / CORS (read by lore) ---
# Comma-separated origins allowed in addition to same-origin, e.g. https://lore.example.com
# (reverse-proxy origin policy; honored only while TRUSTED_PROXY=1)
LORE_PUBLIC_ORIGINS=
# Comma-separated extra Host-header values the web UI accepts (e.g. lore.example.com).
# The literal '*' disables Host validation entirely.
# LORE_ALLOWED_HOSTS=

# --- Rate limits (web UI) ---
LORE_RATE_LIMIT_ENABLED=true
LORE_RATE_LIMIT_WINDOW_SECONDS=60
LORE_RATE_LIMIT_MAX_API_REQUESTS=240
LORE_RATE_LIMIT_SEARCH_PER_WINDOW=180
LORE_RATE_LIMIT_AUDIT_PER_WINDOW=20
LORE_RATE_LIMIT_RELOAD_PER_WINDOW=12
LORE_JSON_REQUEST_LOGS=false

# --- Optional (read by lore; uncomment when needed) ---
# FLASK_SECRET_KEY=
# TRUSTED_PROXY=1
# LORE_WEB_HOST=127.0.0.1
# LORE_WEB_PORT=5000
# LORE_WATCH=1
# LORE_WATCH_INTERVAL=30
# LORE_HYBRID_SEARCH=1
# LORE_USE_V2=1
# LORE_LLM_PROVIDER=
# LORE_OPENROUTER_MODEL=
# LORE_OPENROUTER_ALLOW_PAID=0
# LORE_MCP_ALLOW_SUMMARIZE=0
# LORE_SUMMARY_PROVIDER=
# LORE_SUMMARY_MODEL=
