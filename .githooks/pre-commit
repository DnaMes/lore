#!/bin/bash
# Git identity guard: blocks a commit whose user.email does not match the
# directory it is made in.
#
# Only the personal identity is built in. Every other identity (an employer
# account, a client) is read from a rules file that lives OUTSIDE every
# repository, so this file, and each repository that carries a copy of it,
# names no employer:
#
#   ${GIT_IDENTITY_RULES:-$HOME/.config/git-identity/rules}
#
# The rules file is sourced by this hook and may call two functions:
#   rule '<path-glob>' '<email>' '<label>'   commits under a matching path must use <email>
#   leak '<path-glob>' '<regex>'             block staged content matching <regex> under a matching path
#
# Evaluation order: the built-in */repos/personal/* rule, then the rules file
# in file order (so a specific path can precede a generic one), then the
# built-in */projects/* rule. Canonical copy and an example rules file:
# claude-setup, githooks/.

set -e

PERSONAL_EMAIL="webmaster@semek.org"
RULES_FILE="${GIT_IDENTITY_RULES:-$HOME/.config/git-identity/rules}"

RULE_GLOBS=()
RULE_EMAILS=()
RULE_LABELS=()
LEAK_GLOBS=()
LEAK_REGEXES=()

# shellcheck disable=SC2329 # called from the sourced rules file
rule() {
    RULE_GLOBS+=("$1")
    RULE_EMAILS+=("$2")
    RULE_LABELS+=("$3")
}

# shellcheck disable=SC2329 # called from the sourced rules file
leak() {
    LEAK_GLOBS+=("$1")
    LEAK_REGEXES+=("$2")
}

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# `set -e` plus a failing command used to abort this hook with no output at all
# (claude-setup#29). Every failure below is therefore reported before exiting.
# A rules file that exists but cannot be loaded must block, never fall through:
# an unreadable file or a syntax error halfway down would otherwise apply only
# the rules above the error and silently skip the rest.
if [[ -e "$RULES_FILE" ]]; then
    if [[ ! -r "$RULES_FILE" ]] || ! bash -n "$RULES_FILE" 2>/dev/null; then
        echo -e "${RED}❌ COMMIT BLOCKED - identity rules file is unreadable or has a syntax error: ${RULES_FILE}${NC}"
        echo -e "Check it with: bash -n ${RULES_FILE}"
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$RULES_FILE" || {
        echo -e "${RED}❌ COMMIT BLOCKED - identity rules file failed to load: ${RULES_FILE}${NC}"
        exit 1
    }
fi

# `git config user.email` exits 1 when unset; fall back to empty and fail loud.
CURRENT_EMAIL=$(git config user.email 2>/dev/null || true)
CURRENT_DIR=$(pwd)

if [[ -z "$CURRENT_EMAIL" ]]; then
    echo -e "${RED}❌ COMMIT BLOCKED - no git user.email configured for this repo/user.${NC}"
    echo -e "Run: git config user.email \"you@example.com\" (or --global)"
    exit 1
fi

EXPECTED_EMAIL=""
LOCATION=""

if [[ "$CURRENT_DIR" == */repos/personal/* ]]; then
    EXPECTED_EMAIL="$PERSONAL_EMAIL"
    LOCATION="Personal GitHub"
else
    for i in "${!RULE_GLOBS[@]}"; do
        # shellcheck disable=SC2053 # the rule glob is meant to be a pattern
        if [[ "$CURRENT_DIR" == ${RULE_GLOBS[$i]} ]]; then
            EXPECTED_EMAIL="${RULE_EMAILS[$i]}"
            LOCATION="${RULE_LABELS[$i]}"
            break
        fi
    done
    if [[ -z "$EXPECTED_EMAIL" && "$CURRENT_DIR" == */projects/* ]]; then
        EXPECTED_EMAIL="$PERSONAL_EMAIL"
        LOCATION="Personal projects (~/projects)"
    fi
fi

if [[ -z "$EXPECTED_EMAIL" ]]; then
    echo -e "${YELLOW}⚠️  WARNING: Repository outside managed directories!${NC}"
    echo -e "Current directory: ${CURRENT_DIR}"
    echo -e "Current email: ${CURRENT_EMAIL}"
    echo ""
    echo -e "Recommended directories:"
    echo -e "  ~/repos/personal/  or  ~/projects/   (for ${PERSONAL_EMAIL})"
    if [[ -r "$RULES_FILE" ]]; then
        echo -e "Other identities are defined in ${RULES_FILE} (no rule matches this directory)."
    else
        echo -e "Other identities are defined in ${RULES_FILE} (file not found)."
    fi
    echo ""
    # Non-interactive mode (scripts, agents): allow if personal email is set
    if [[ ! -t 0 ]]; then
        if [[ "$CURRENT_EMAIL" == "$PERSONAL_EMAIL" ]]; then
            exit 0
        else
            echo -e "${RED}❌ Non-interactive commit blocked: set git user.email to ${PERSONAL_EMAIL}${NC}"
            exit 1
        fi
    fi
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
    exit 0
fi

# Verify email matches expected location
if [ "$CURRENT_EMAIL" != "$EXPECTED_EMAIL" ]; then
    echo -e "${RED}❌ COMMIT BLOCKED - WRONG ACCOUNT!${NC}"
    echo ""
    echo -e "Location: ${LOCATION}"
    echo -e "Expected: ${GREEN}${EXPECTED_EMAIL}${NC}"
    echo -e "Current:  ${RED}${CURRENT_EMAIL}${NC}"
    echo ""
    echo -e "To fix this, run:"
    echo -e "  ${YELLOW}git config user.email \"${EXPECTED_EMAIL}\"${NC}"
    echo ""
    exit 1
fi

# Success!
echo -e "${GREEN}✓${NC} Account verified: ${CURRENT_EMAIL} (${LOCATION})"

# Content-level leak check, separate from the author-field check above. Incident
# 2026-07-28: an editor session-scratch file (.specstory/.project.json) carried
# the personal address as file CONTENT while the commit author was correct.
# Author verification alone does not catch that class of leak, so this scans the
# staged diff in every tree a `leak` rule covers.
for i in "${!LEAK_GLOBS[@]}"; do
    # shellcheck disable=SC2053 # the rule glob is meant to be a pattern
    [[ "$CURRENT_DIR" == ${LEAK_GLOBS[$i]} ]] || continue
    LEAKED_HITS=$(git diff --cached -U0 | grep -E '^\+' | grep -viE '^\+\+\+' | grep -EI "${LEAK_REGEXES[$i]}" || true)
    if [[ -n "$LEAKED_HITS" ]]; then
        echo -e "${RED}❌ COMMIT BLOCKED - PRIVATE IDENTITY IN STAGED CONTENT!${NC}"
        echo ""
        echo -e "A leak rule in ${RULES_FILE} matches the staged diff:"
        echo "$LEAKED_HITS" | head -10
        echo ""
        echo -e "${YELLOW}This directory must never contain that identity in committed content,${NC}"
        echo -e "${YELLOW}even if the commit author is correct.${NC}"
        echo -e "Remove the offending file/content before committing (common source: AI"
        echo -e "coding-assistant session-scratch files like .specstory/.project.json —"
        echo -e "these should be caught by ~/.gitignore_global, check why they weren't)."
        echo ""
        exit 1
    fi
done

exit 0
